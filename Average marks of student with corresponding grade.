
marks = []

n = int(input("Enter the number of subjects: "))

for i in range(n):
    marks.append(int(input(f"Subject {i+1} marks: ")))

average = sum(marks) / n

print("Average marks:", average)

if average >= 90:
    print("Grade A")
elif average >= 60:
    print("Grade B")
elif average >= 30:
    print("Grade C")
else:
    print("You are Failed, Work Hard!")
